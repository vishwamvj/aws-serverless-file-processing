# Spring Boot application and Lambda deployment configuration.
# Replace placeholder values locally; never commit real credentials.
S3_INPUT_BUCKET=your-input-bucket-name
OUTPUT_BUCKET=your-output-bucket-name
METADATA_API_URL=https://your-api-id.execute-api.your-aws-region.amazonaws.com/metadata
AWS_REGION=your-aws-region

# Required by the file-validator Lambda.
IMAGE_QUEUE_URL=https://sqs.your-aws-region.amazonaws.com/your-aws-account-id/your-image-queue
PDF_QUEUE_URL=https://sqs.your-aws-region.amazonaws.com/your-aws-account-id/your-pdf-queue

# Required by the image and PDF processor Lambdas.
SNS_TOPIC_ARN=arn:aws:sns:your-aws-region:your-aws-account-id:your-topic-name

# Optional DynamoDB table names.
IMAGE_TABLE=your-image-table-name
PDF_TABLE=your-pdf-table-name
